# Copy to Netlify UI → Site settings → Environment variables
# Never commit real secrets.

GITHUB_TOKEN=
PUBLIC_SITE_URL=https://your-site.netlify.app
SCAN_TRIGGER_SECRET=change-me-long-random
OPERATOR_SESSION_SECRET=
ENABLE_AUTOMATED_SCANS=true
ENABLE_GITHUB_DISCOVERY=true
MAX_SCAN_SOURCES=40
MAX_SCAN_CANDIDATES=100
SIMILARITY_THRESHOLD=0.55
MAX_PER_CLUSTER=3
